---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content.config';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const countOf = (key: string) => posts.filter((p) => p.data.category === key).length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-head {
				margin: 1.5em 0 2em;
			}
			.page-head h1 {
				margin: 0 0 0.3em;
			}
			.page-head p {
				margin: 0;
				color: var(--stone);
				font-size: 0.95rem;
			}
			.cat-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.2em;
			}
			.cat-card {
				display: block;
				background: var(--ivory);
				border: 1px solid var(--line-strong);
				border-radius: 16px;
				padding: 1.4em 1.5em;
				box-shadow: var(--shadow-soft);
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
			}
			.cat-card:hover {
				transform: translateY(-2px);
				border-color: var(--terra);
				text-decoration: none;
			}
			.cat-card:hover h2 {
				color: var(--terra);
			}
			.cat-card h2 {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin: 0 0 0.4em;
				font-size: 1.3rem;
				transition: color 0.2s ease;
			}
			.count {
				font-family: var(--font-sans);
				font-size: 0.85rem;
				font-weight: 400;
				color: var(--stone);
			}
			.cat-card p {
				margin: 0;
				color: var(--olive);
				font-size: 0.92rem;
				line-height: 1.7;
			}
			@media (max-width: 640px) {
				.cat-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<h1>博客</h1>
				<p>按卡片类型分组。点进去看每一类。</p>
			</div>
			<div class="cat-grid">
				{
					CATEGORIES.map((cat) => (
						<a class="cat-card" href={`/blog/${cat.subpath}/`}>
							<h2>
								{cat.name}
								<span class="count">{countOf(cat.key)} 篇</span>
							</h2>
							<p>{cat.description}</p>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
